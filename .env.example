# Start with mock. No Gemini calls are made in mock mode.
AI_MODE=mock
RESEARCH_MODE=supplied
GEMINI_API_KEY=
# Choose a model enabled for your account. Supplied-source mode needs no Search tool.
GEMINI_MODEL=gemini-3.5-flash-lite
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
# Comma-separated Discord user IDs allowed to run commands.
DISCORD_ALLOWED_USER_IDS=
# Optional avatar overrides. Blank uses the bundled v1.0 pixel avatars from GitHub.
MANAGER_AVATAR_URL=
RESEARCHER_AVATAR_URL=
WRITER_AVATAR_URL=

# Optional Phase 2 server-only database mirror. See supabase/SETUP.md.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional compatibility with an existing legacy key:
SUPABASE_SERVICE_ROLE_KEY=

# Cloud hosting and private Google login. See docs/ONLINE-SETUP.md.
# Local mode is the default. Production always requires authentication.
BEJ_STORAGE=local
BEJ_AUTH_REQUIRED=false
BEJ_PUBLIC_URL=
BEJ_OWNER_EMAIL=
# Auth uses a publishable key (or legacy anon key), never the server secret.
SUPABASE_PUBLISHABLE_KEY=
