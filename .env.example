# Start with mock. No Gemini calls are made in mock mode.
AI_MODE=mock
RESEARCH_MODE=supplied
GEMINI_API_KEY=
# Choose a model enabled for your account. Supplied-source mode needs no Search tool.
GEMINI_MODEL=gemini-3.5-flash-lite
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
# Comma-separated Discord user IDs allowed to run commands.
DISCORD_ALLOWED_USER_IDS=
# Optional public HTTPS pixel-avatar URLs (one shared webhook, three identities).
MANAGER_AVATAR_URL=
RESEARCHER_AVATAR_URL=
WRITER_AVATAR_URL=

# Optional Phase 2 server-only database mirror. See supabase/SETUP.md.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional compatibility with an existing legacy key:
SUPABASE_SERVICE_ROLE_KEY=
